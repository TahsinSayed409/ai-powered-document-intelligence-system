APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./document_intelligence.db
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_PARALLEL_REQUESTS=1
OLLAMA_RETRIES=2
OLLAMA_KEEP_ALIVE=10m
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=250
TESSERACT_PATH=C:\path\to\tesseract.exe
TESSERACT_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=120
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,xlsx,xls,csv
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
POSTGRES_DB=document_intelligence
POSTGRES_USER=appuser
POSTGRES_PASSWORD=local-development-only
